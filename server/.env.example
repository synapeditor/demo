# Demo server port
PORT=3080

# Document export server
EXPORT_SERVER=

# Collaboration WebSocket server
# If using Docker collabo server: ws://127.0.0.1:1234
# See docker/collabo/README.md for setup instructions
COLLABO_SERVER=

# Converter API server (Mac/Linux: Docker container)
# Start: cd docker && docker-compose up -d converter-api
# CONVERTER_SERVER=http://127.0.0.1:8080

# Extensions /uploadFile accepts, comma separated. Unset keeps the built-in list
# (images, video, audio, office/PDF/text, archives); a value here replaces it.
# UPLOAD_ALLOWED_EXT=.png,.jpg,.pdf
